<% content_for(:title) { "Library | Writebook" } %>
<% @layout_class = "books" %>

<% content_for :header do %>
  <nav>
    <span class="btn btn--placeholder" aria-hidden="true"></span>

    <a href="https://once.com/writebook" class="product__wordmark btn btn--plain txt-large center" target="_blank">
      <%= image_tag "writebook-icon.svg", aria: { hidden: true }, size: 24 %>
      <span>Writebook</span>
    </a>

    <% if Current.user %>
      <% if Current.user.can_administer? %>
        <%= link_to books_order_path, class: "btn" do %>
          <%= image_tag "rearrange.svg", aria: { hidden: true }, size: 24 %>
          <span class="for-screen-reader">Reorder books</span>
        <% end %>

        <%= link_to static_export_path, class: "btn" do %>
          <%= image_tag "download.svg", aria: { hidden: true }, size: 24 %>
          <span class="for-screen-reader">Export to static site</span>
        <% end %>
      <% end %>

      <%= link_to users_path, class: "btn" do %>
        <%= image_tag "settings.svg", aria: { hidden: true }, size: 24 %>
        <span class="for-screen-reader">Manage people and settings</span>
      <% end %>
    <% else %>
      <%= link_to new_session_path, class: "btn" do %>
        <%= image_tag "login-keys.svg", aria: { hidden: true }, size: 24 %>
        <span class="for-screen-reader">Sign in</span>
      <% end %>
    <% end %>
  </nav>
<% end %>

<% cache [ @books, signed_in? ] do %>
  <div class="library library--shelf"
       data-controller="library"
       data-action="keydown->library#navigate click->library#select pointerdown->library#pointerStart pointerup->library#pointerEnd pointercancel->library#pointerCancel dragstart->library#dragStart"
       role="region"
       aria-roledescription="carousel"
       aria-label="Book library"
       tabindex="0">
    <div class="shelf">
      <ol class="shelf__track" role="list">
        <% @books.each do |book| %>
          <li class="shelf__slot"><%= render book %></li>
        <% end %>

        <% if signed_in? %>
          <li class="shelf__slot"><%= render "books/new" %></li>
        <% end %>
      </ol>
    </div>

    <div class="shelf__controls">
      <button type="button" class="btn btn--circle shelf__nav" data-library-target="previous" data-action="library#previous" aria-label="Previous book">
        <%= image_tag "arrow-left.svg", aria: { hidden: true }, size: 24 %>
      </button>

      <p class="shelf__count txt-caps" data-library-target="count" aria-live="polite"></p>

      <button type="button" class="btn btn--circle shelf__nav" data-library-target="next" data-action="library#next" aria-label="Next book">
        <%= image_tag "arrow-right.svg", aria: { hidden: true }, size: 24 %>
      </button>
    </div>
  </div>
<% end %>
