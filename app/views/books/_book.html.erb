<% cache book do %>
  <figure class="library__book shelf__book <%= "theme--#{book&.theme}" unless book.cover.attached? %>"
          data-library-target="book"
          data-library-href="<%= book_slug_path(book) %>"
          data-library-label="<%= book.title %>">
    <div class="shelf__link-position">
      <span class="shelf__object">
        <span class="shelf__face shelf__face--front">
          <% if book.cover.attached? %>
            <%= image_tag book.cover, alt: "Book cover", class: "book__cover" %>
          <% else %>
            <span class="book__cover-wrapper">
              <%= image_tag "empty-cover.png", alt: "Book cover", class: "book__cover margin-block-none center" %>
              <span class="book__title overflow-line-clamp pad txt-align-start txt-tight-lines" style="--lines: 6" aria-hidden="true"><%= book.title %></span>
            </span>
          <% end %>
        </span>

        <span class="shelf__face shelf__face--spine" aria-hidden="true"></span>
        <span class="shelf__face shelf__face--pages" aria-hidden="true"></span>
        <span class="shelf__face shelf__face--back" aria-hidden="true"></span>
        <span class="shelf__face shelf__face--top" aria-hidden="true"></span>
        <span class="shelf__face shelf__face--bottom" aria-hidden="true"></span>
      </span>

      <%= turbo_frame_tag dom_id(book, :bookmark), src: book_bookmark_path(book), target: "_top" %>
    </div>

    <h2 class="margin-none flex flex-column txt-normal txt-tight-lines txt-medium--responsive">
      <strong><%= book.title %></strong>
      <span class="overflow-line-clamp"><%= book.author %></span>
    </h2>
  </figure>
<% end %>
